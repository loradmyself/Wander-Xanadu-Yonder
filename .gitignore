# ---------------------------------------------------------------
# Wander-Xanadu-Yonder (WXY) · AI 玩伴平台
# ---------------------------------------------------------------

# SiFli-SDK 是子模块（见 .gitmodules），不是主仓源码。
# 本地工作副本不入库；干净克隆后执行：
#   git submodule update --init --depth 1
# 注意：不要在此目录内提交任何东西，也不要把它从 .gitmodules 里删掉。


# 构建产物
build_*/
output/
app-packages/
# 构建期 eZip 转换的生成物（*/*.png -> *.tmp.c，见 src/ui/SConscript；
# 现在产物落 build_xxx/wxy_ui/，这里保留兜底防止意外落到源码树）
*.tmp.c
*.o
*.obj
*.a
*.lib
*.elf
*.map
*.axf
*.hex
*.img
*.dmp
*.sconsign.dblite
.sconsign.dblite

# 固件镜像与分区表产物（源码里的 bin 依赖除外，见下方取反规则）
*.bin
*.xzp

# 构建时按需保留的资源二进制（波形、表情包、音效）
!assets/**/*.bin
!assets/**/*.xzp
!docs/**/*.bin

# ---------------------------------------------------------------
# Python / 工具链
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.sf-pkg/
.pytest_cache/

# ---------------------------------------------------------------
# 编辑器与 IDE
# ---------------------------------------------------------------
.vscode/
.idea/
*.uvguix.*
*.uvoptx
*.uvprojx
*.scvd

# ---------------------------------------------------------------
# 系统与临时文件
# ---------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.log
*.bak
*.tmp
*.orig
*.rej
*.swp
*~

# ---------------------------------------------------------------
# 密钥与本地配置（绝不入库）
# ---------------------------------------------------------------
secrets/
*.secret
*.pem
*.key
local.conf
*.local
