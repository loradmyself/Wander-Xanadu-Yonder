# 默认按文本处理，统一 LF，避免 Windows 上 CRLF 混入源码
* text=auto eol=lf

*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.conf    text eol=lf
*.cfg     text eol=lf
*.SConstruct text eol=lf
SConstruct   text eol=lf
SConscript   text eol=lf
Kconfig      text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Windows 脚本保持 CRLF，避免 cmd/powershell 解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制资源：不做换行转换，且不让 git 尝试 diff
*.bin     binary
*.xzp     binary
*.ttf     binary
*.otf     binary
*.woff2   binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.bmp     binary
*.mp3     binary
*.wav     binary
*.pdf     binary
*.zip     binary
