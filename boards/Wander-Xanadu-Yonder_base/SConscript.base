from building import *

cwd = GetCurrentDir()

src = Glob('*.c')

path =  [os.path.join(cwd, "."), 
         os.path.join(cwd, '../include'), 
         os.path.join(os.getenv('SIFLI_SDK'), 'customer/peripherals/ioexpander/aw9523')]

group = DefineGroup('Drivers', src, depend = [], CPPPATH = path)
Return('group')
