import os
from building import *

cwd = GetCurrentDir()
objs = []

# Add SDK
Import('SIFLI_SDK')
objs.extend(SConscript(os.path.join(SIFLI_SDK, 'SConscript'), variant_dir="sifli_sdk", duplicate=0))

# Add ACPU sources
objs.extend(SConscript(cwd + '/src/SConscript', variant_dir="acpu_src", duplicate=0))

Return('objs')
