import os
from building import *
from runtime_paths import configure

configure(GetCurrentEnv())

cwd = GetCurrentDir()
objs = []

# Add SDK
Import('SIFLI_SDK')
objs.extend(SConscript(os.path.join(SIFLI_SDK, 'SConscript'), variant_dir="sifli_sdk", duplicate=0))

# Add platform sources.
# font/ and assets/ are intentionally not wired yet: they arrive with the first
# on-screen milestone. Empty directories here would break the build.
objs.extend(SConscript(cwd + '/../src/SConscript', variant_dir="src", duplicate=0))

Return('objs')
